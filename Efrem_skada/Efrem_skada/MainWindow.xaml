<Window x:Class="Efrem_skada.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCADA - Efrem" 
        Height="450" 
        Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F5E6D3">
        <!-- Большой прямоугольник (остаётся) -->
        <Rectangle Width="256" Height="178" 
                   Fill="DodgerBlue" 
                   Stroke="Navy" 
                   StrokeThickness="3"
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top" 
                   Margin="52,217,0,0" />

        <!-- Красная рамка с числом (Border вместо Rectangle) -->
        <Border Width="100" Height="60"
                Background="Red"
                BorderBrush="DarkRed"
                BorderThickness="3"
                CornerRadius="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="326,25,0,0">
            <TextBlock x:Name="ValueText" 
                       Text="0" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Кнопка "<" -->
        <Button x:Name="MinusButton" 
                Width="100" Height="60"
                Background="DodgerBlue"
                BorderBrush="Navy"
                BorderThickness="4"
                FontSize="36"
                FontWeight="Bold"
                Foreground="White"
                Content="&lt;"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="266,97,0,0"
                Click="MinusButton_Click"/>

        <!-- Кнопка ">" -->
        <Button x:Name="PlusButton" 
                Width="100" Height="60"
                Background="DodgerBlue"
                BorderBrush="Navy"
                BorderThickness="4"
                FontSize="36"
                FontWeight="Bold"
                Foreground="White"
                Content="&gt;"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="388,97,0,0"
                Click="PlusButton_Click"/>
    </Grid>
</Window>